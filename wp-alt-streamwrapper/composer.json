{
    "name": "mitchmac/wp-alt-streamwrapper",
    "description": "WordPress plugin that intercepts wp-content file operations and routes them to remote object storage (S3, Vercel Blob)",
    "type": "wordpress-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "WpAltStreamWrapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WpAltStreamWrapper\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "extra": {
        "aws/aws-sdk-php": [
            "S3"
        ]
    },
    "scripts": {
        "pre-autoload-dump": "Aws\\Script\\Composer\\Composer::removeUnusedServices"
    }
}
